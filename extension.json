{
  "identifier": "net.minrk.pre-commit",
  "name": "pre-commit",
  "organization": "minrk",
  "description": "Run pre-commit checks",
  "version": "1.1.0",
  "homepage": "https://github.com/minrk/pre-commit.novaextension",
  "bugs": "https://github.com/minrk/pre-commit.novaextension/issues",
  "license": "BSD-3-Clause",

  "categories": ["commands", "formatters"],

  "main": "main.js",

  "entitlements": {
    "filesystem": "readwrite",
    "process": true
  },

  "commands": {
    "editor": [
      {
        "title": "pre-commit run on all files",
        "command": "pre-commit.runAllFiles"
      },
      {
        "title": "pre-commit run on current file",
        "command": "pre-commit.runCurrent"
      }
    ]
  },

  "config": [
    {
      "key": "pre-commit.executable",
      "title": "executable",
      "type": "path",
      "description": "Set path to pre-commit (or prek) executable. Default: auto",
      "default": ""
    },
    {
      "key": "pre-commit.preferPreK",
      "title": "Prefer prek to pre-commit",
      "type": "boolean",
      "description": "Prefer prek to pre-commit if both are found when auto-detecting executable. Ignored if executable is set above.",
      "default": true
    },
    {
      "key": "pre-commit.showOutput",
      "title": "Show pre-commit output on error",
      "type": "boolean",
      "default": false
    },
    {
      "key": "pre-commit.runOnSave",
      "title": "Run pre-commit on save",
      "type": "boolean",
      "default": false
    }
  ]
}
